<Window
    x:Class="WeChatCopilot.App.PersonaAnalyticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="联系人多维心智画像全景深度分析看板"
    Icon="app.ico"
    Width="1060"
    Height="740"
    MinWidth="880"
    MinHeight="600"
    Background="{DynamicResource WindowBg}"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="-1"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  基础调色板  -->
        <SolidColorBrush x:Key="WindowBg" Color="#0F121C" />
        <SolidColorBrush x:Key="CardBg" Color="#161B26" />
        <SolidColorBrush x:Key="CardSubtleBg" Color="#1C2232" />
        <SolidColorBrush x:Key="BorderColor" Color="#283248" />
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentRose" Color="#F43F5E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />

        <!--  通用按钮样式 (顶部复制/导出按钮)  -->
        <Style x:Key="TopActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource CardSubtleBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="btnBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主要高光按钮样式  -->
        <Style
            x:Key="PrimaryAccentButton"
            BasedOn="{StaticResource TopActionButton}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  选项卡样式  -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="tabBorder"
                            Margin="0,0,6,0"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="4,4,0,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource SubBorderCheckedBrush}" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SubBorderCheckedTextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口控制按钮样式 -->
        <Style x:Key="WindowCtrlButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A3448" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2536" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险/关闭控制按钮样式 -->
        <Style x:Key="WindowCloseButton" BasedOn="{StaticResource WindowCtrlButton}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  现代下拉框切换按钮样式  -->
        <Style x:Key="FluentComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="templateRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <Path
                                x:Name="arrow"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Data="M 0 0 L 4 4 L 8 0"
                                Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                IsHitTestVisible="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource AccentCyan}" />
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource AccentCyan}" />
                                <Setter TargetName="arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代下拉框选项项样式 -->
        <Style x:Key="FluentComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="Bd"
                            Margin="1,1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubBorderCheckedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SubBorderCheckedTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代下拉框主样式 -->
        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FluentComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton
                                x:Name="toggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource FluentComboBoxToggleButton}" />
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.Foreground="{DynamicResource TextPrimary}" />
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="dropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,3,0,6"
                                    Padding="4"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="12"
                                            Direction="270"
                                            Opacity="0.3"
                                            ShadowDepth="3"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItem}" />
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 0: 顶部全景边框与控制栏 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 主内容 Tab 切换区 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: 顶部全景边框与控制栏 ==================== -->
        <Border
            Grid.Row="0"
            x:Name="HeaderBorder"
            Background="{DynamicResource CardSubtleBg}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,0,1"
            Padding="16,10"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：联系人主体信息与画像元数据胶囊 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#2638BDF8" BorderBrush="#5538BDF8" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            x:Name="HeaderContactName"
                            Text="联系人全景画像看板"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center" />
                        <Border
                            x:Name="HeaderSkillBadge"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            Background="#2238BDF8"
                            BorderBrush="#4438BDF8"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="HeaderSkillText"
                                Text="❤️ 亲密关系与情感偏好"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentCyan}" />
                        </Border>
                    </StackPanel>

                    <!-- 元数据指标标签组 -->
                    <StackPanel
                        Margin="0,5,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="MetaSourceCount"
                            Text="💬 基于 186 条历史真实消息"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0,0,14,0" />
                        <TextBlock
                            x:Name="MetaUpdatedTime"
                            Text="⏱ 更新时间: 2026-10-10 14:54"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0,0,14,0" />
                        <TextBlock
                            x:Name="MetaDimensionCount"
                            Text="📊 共提取 6 个独立量化特质维度"
                            FontSize="11"
                            Foreground="{StaticResource AccentGreen}"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：功能操作按钮组与窗口控制组 -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <!-- 业务功能按钮 -->
                    <Button
                        x:Name="CopyReportButton"
                        Click="CopyReportButton_Click"
                        Content="📋 复制完整分析报告"
                        Style="{StaticResource TopActionButton}"
                        Margin="0,0,8,0"
                        ToolTip="一键复制格式化的 Markdown 深度心智特质与实战破局分析报告到剪贴板" />
                    <Button
                        x:Name="ExportReportButton"
                        Click="ExportReportButton_Click"
                        Content="💾 导出报告文本"
                        Style="{StaticResource TopActionButton}"
                        Margin="0,0,14,0"
                        ToolTip="将画像分析报告导出保存为本地文件" />

                    <!-- 分割线 -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderColor}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <!-- 窗口控制按钮组 (像建议中的放大看板一样) -->
                    <Button
                        x:Name="MinimizeButton"
                        Style="{StaticResource WindowCtrlButton}"
                        Click="MinimizeButton_Click"
                        ToolTip="最小化">
                        <TextBlock Text="─" FontSize="12" FontWeight="Bold" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        Style="{StaticResource WindowCtrlButton}"
                        Click="MaximizeButton_Click"
                        ToolTip="最大化/还原">
                        <TextBlock x:Name="MaximizeButtonIcon" Text="🗖" FontSize="11" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Style="{StaticResource WindowCloseButton}"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: 核心分析 Tab 区域 ==================== -->
        <TabControl
            Grid.Row="1"
            Margin="16,10,16,14"
            Background="Transparent"
            BorderThickness="0">

            <!--  TAB 1: 多维可视化图表看板 (雷达图 + 柱状图 + 折线图)  -->
            <TabItem Header="📊 多维可视化图表看板 (雷达图 / 柱状图 / 折线图)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- Row 0: 核心动态特质与张力概览卡片行 (置顶呈现) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: 图表可视化全景展示区 (雷达图 + 柱状图 + 折线图) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  上部：核心动态特质与张力概览卡片行 (置顶)  -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  卡片 1：第一主导维度  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Padding="12,10"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="#3310B981"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="StatCard1Header" Text="🌟 第一主导维度" FontSize="11" Foreground="{StaticResource AccentGreen}" />
                                <TextBlock x:Name="StatTopDimText" Text="关键认知" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatTopScoreText" Text="96分 (显著高位)" FontSize="11" Foreground="{StaticResource AccentGreen}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!--  卡片 2：协同支柱维度  -->
                        <Border
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="12,10"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="#3338BDF8"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="StatCard2Header" Text="✨ 协同支柱维度" FontSize="11" Foreground="{StaticResource AccentCyan}" />
                                <TextBlock x:Name="StatCard2DimText" Text="间接传递方式" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatCard2ScoreText" Text="91分 (高位表现)" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!--  卡片 3：防备敏感/洼地维度  -->
                        <Border
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="12,10"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="#33F43F5E"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="StatCard3Header" Text="🛡️ 心理敏感/洼地维度" FontSize="11" Foreground="{StaticResource AccentRose}" />
                                <TextBlock x:Name="StatLowDimText" Text="低位框架" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatLowScoreText" Text="22分 (防备防线)" FontSize="11" Foreground="{StaticResource AccentRose}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!--  卡片 4：心智极差与综合可信度  -->
                        <Border
                            Grid.Column="3"
                            Padding="12,10"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="#33F59E0B"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="StatCard4Header" Text="⚡ 心智张力极差与均分" FontSize="11" Foreground="{StaticResource AccentAmber}" />
                                <TextBlock x:Name="StatSpreadText" Text="74分极差 (均分 69.5)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" />
                                <TextBlock x:Name="StatAvgConfidenceText" Text="可信度: 0.90 (高可信样本)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  下部：左侧大雷达图 + 右侧柱状图与折线图  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!--  左栏：全景雷达图  -->
                            <ColumnDefinition Width="1.05*" />
                            <!--  右栏：柱状对比图与梯度折线图  -->
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧卡片：高分辨率全景多维雷达图谱  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="14"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  标题栏  -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        Text="🎯 全景多维认知雷达图谱"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock
                                        Text="高精度全维度呈现，中心辐射各特质量化分，无任何截断或省略"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Margin="0,2,0,0" />
                                </StackPanel>

                                <!--  大尺寸雷达图画布  -->
                                <Canvas
                                    x:Name="LargeRadarCanvas"
                                    Grid.Row="1"
                                    Width="430"
                                    Height="330"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                <!--  底部图例说明  -->
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                                    <Border
                                        Width="10"
                                        Height="10"
                                        Background="#38BDF8"
                                        CornerRadius="2"
                                        Margin="0,0,4,0" />
                                    <TextBlock
                                        Text="量化得分 (10~100)"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Margin="0,0,14,0" />
                                    <Border
                                        Width="10"
                                        Height="2"
                                        Background="#4D94A3B8"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="中性基准线 (50分)"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  右侧卡片区：各维度量化柱状图 + 特质波动折线图  -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <!--  柱状图卡片  -->
                                <RowDefinition Height="1*" />
                                <!--  折线图卡片  -->
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <!--  右上方：各维度量化对比柱状图 (Horizontal Bar Chart)  -->
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                Padding="14,12"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock
                                            Text="📊 各维度量化得分对比柱状图"
                                            FontSize="13.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock
                                            Text="直观对比各特质得分梯度，快速识别其高位优势区与防御敏感区"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Margin="0,2,0,8" />
                                    </StackPanel>

                                    <!--  柱状图列表容器 (垂直居中填充，杜绝底部大片空白)  -->
                                    <ScrollViewer
                                        Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="BarChartContainer" VerticalAlignment="Center" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!--  右下方：特质梯度与波动分布折线图 (Line Chart)  -->
                            <Border
                                Grid.Row="1"
                                Padding="14,12"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock
                                            Text="📈 特质波动与梯度走势折线图"
                                            FontSize="13.5"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock
                                            Text="维度间心理张力起伏曲线，虚线为全体维度加权均分"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Margin="0,2,0,4" />
                                    </StackPanel>

                                    <Canvas
                                        x:Name="LineChartCanvas"
                                        Grid.Row="1"
                                        Width="480"
                                        Height="125"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  TAB 2: 全维度特质与原始证据清单  -->
            <TabItem Header="🔍 全维度特质与原始证据清单">
                <Border
                    Margin="0,10,0,0"
                    Padding="16"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock
                                Text="📑 观察层与推断层全量锚定清单"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock
                                Text="左侧深度推断心智模式，右侧严密锚定亲口原话证据；左右对照，一目了然"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TraitsDetailItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="14,12"
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- 头部：维度名称与得分置信度 -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- 主体：左右对照结构 -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 卡片头部：维度名称 + 得分徽章 + 置信度 + 标签 -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Dimension}"
                                                            FontSize="14.5"
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center" />
                                                        <Border
                                                            Margin="8,0,0,0"
                                                            Padding="7,2"
                                                            Background="{DynamicResource PillGoalBgBrush}"
                                                            BorderBrush="{DynamicResource PillGoalBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding ScoreText}"
                                                                FontSize="11"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource PillGoalLabelBrush}" />
                                                        </Border>
                                                        <Border
                                                            Margin="6,0,0,0"
                                                            Padding="6,2"
                                                            Background="{DynamicResource IntentFlowBgBrush}"
                                                            BorderBrush="{DynamicResource IntentFlowBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding ConfidencePercentText, StringFormat='可信度: {0}'}"
                                                                FontSize="10.5"
                                                                Foreground="{DynamicResource IntentFlowTextBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- 右侧：特质风格标签徽章 -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,2"
                                                        Background="{Binding SkillTagBrush}"
                                                        CornerRadius="4"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding SkillTag}"
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="#FFFFFF" />
                                                    </Border>
                                                </Grid>

                                                <!-- 左右对照区域：左侧【推断层】 vs 右侧【观察层证据】 -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- 左列：推断层 -->
                                                        <ColumnDefinition Width="1*" />
                                                        <!-- 中间间距 -->
                                                        <ColumnDefinition Width="12" />
                                                        <!-- 右列：观察层原话证据 -->
                                                        <ColumnDefinition Width="1.15*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 左边：🧠 深度心智特质推断 (推断层) -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="12,10"
                                                        Background="{DynamicResource CardSubtleBg}"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Text="🧠 深度心智特质推断（推断层）"
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource TextSecondary}"
                                                                Margin="0,0,0,6" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Text="{Binding Attribute}"
                                                                FontSize="12.5"
                                                                Foreground="{DynamicResource TextPrimary}"
                                                                TextWrapping="Wrap"
                                                                LineHeight="20"
                                                                VerticalAlignment="Top" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- 右边：💬 亲口原话佐证 (观察层 · 真实记录) -->
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="12,10"
                                                        Background="{DynamicResource IntentSubtextBgBrush}"
                                                        BorderBrush="{DynamicResource IntentSubtextBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Text="💬 亲口原话佐证（观察层 · 事实依据）"
                                                                    FontSize="11.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PurpleBrush}"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{Binding EvidenceSummary}"
                                                                    FontSize="10.5"
                                                                    Foreground="{DynamicResource TextSecondary}"
                                                                    VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Text="{Binding EvidenceDisplayText}"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource IntentSubtextTextBrush}"
                                                                FontStyle="Italic"
                                                                TextWrapping="Wrap"
                                                                LineHeight="19"
                                                                VerticalAlignment="Top" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!--  TAB 3: 实战沟通破局策略与避坑指南  -->
            <TabItem Header="⚡ 实战沟通破局策略与避坑指南">
                <Border
                    Margin="0,10,0,0"
                    Padding="18,16"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StrategyContentPanel">
                            <TextBlock
                                Text="⚡ 实战沟通破局战术与避坑指南报告"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Margin="0,0,0,4" />
                            <TextBlock
                                x:Name="StrategySubTitle"
                                Text="结合当前认知体系与多维特质分布，生成的定制化沟通实战破局处方"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Margin="0,0,0,14" />

                            <!--  关系定位与 AI 专家深度解读控制栏  -->
                            <Border
                                Margin="0,0,0,14"
                                Padding="12,10"
                                Background="{DynamicResource CardSubtleBg}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 0: 关系标签与下拉选择框 (自适应内容尺寸) -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- 1: 智能研判胶囊标签 (弹性占用剩余空间，超出自动以省略号截断并显示完整 ToolTip，右侧预留 16px 绝对安全间距) -->
                                        <ColumnDefinition Width="*" />
                                        <!-- 2: AI 专家深度破局解读按钮 (右侧靠齐，杜绝任何重叠) -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：关系定位与身份视角（自由输入框，支持用户自行添加任意关系） -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="🎯 关系定位与分析视角："
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0" />
                                        <Border
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="34"
                                            Width="230">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="RelationshipIdentityInput"
                                                    Grid.Column="0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    FontSize="12"
                                                    VerticalContentAlignment="Center"
                                                    Padding="10,0,4,0"
                                                    KeyDown="RelationshipIdentityInput_KeyDown"
                                                    LostFocus="RelationshipIdentityInput_LostFocus"
                                                    ToolTip="自由输入你与对方的关系（如：心仪伴侣、相亲对象、合作伙伴、直属领导、暗恋对象...），按回车立即生效" />
                                                <!-- 下拉快捷填充预设菜单按钮 -->
                                                <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <MenuItem
                                                        Header="▾"
                                                        Padding="6,4"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        ToolTip="点击选择常用关系快速填入">
                                                        <MenuItem Header="❤️ 亲密交往对象 (心仪伴侣)" Click="RelationshipPreset_Click" Tag="亲密交往对象 (心仪伴侣)" />
                                                        <MenuItem Header="💌 相亲交往对象 (相亲发展)" Click="RelationshipPreset_Click" Tag="相亲交往对象 (相亲发展)" />
                                                        <MenuItem Header="👑 职场管理对象 (直属领导)" Click="RelationshipPreset_Click" Tag="职场管理对象 (直属领导)" />
                                                        <MenuItem Header="💼 职场协作对象 (平级同事)" Click="RelationshipPreset_Click" Tag="职场协作对象 (平级同事)" />
                                                        <MenuItem Header="🤝 商业合作对象 (关键客户)" Click="RelationshipPreset_Click" Tag="商业合作对象 (关键客户)" />
                                                        <MenuItem Header="☕ 社交交往对象 (日常朋友)" Click="RelationshipPreset_Click" Tag="社交交往对象 (日常朋友)" />
                                                        <MenuItem Header="✨ 深度合作伙伴 (合伙创业)" Click="RelationshipPreset_Click" Tag="深度合作伙伴 (合伙创业)" />
                                                    </MenuItem>
                                                </Menu>
                                            </Grid>
                                        </Border>
                                        <Button
                                            x:Name="ApplyRelationshipBtn"
                                            Click="ApplyRelationshipBtn_Click"
                                            Style="{StaticResource TopActionButton}"
                                            Height="32"
                                            Padding="10,0"
                                            Margin="8,0,0,0"
                                            Content="应用视角"
                                            ToolTip="根据输入框中的关系，重新生成全景分析视角与破局战术"
                                            VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 中间：智能研判结果胶囊标签 (独立占用 Column 1，右侧预留 16px 隔离，绝不溢出到右侧按钮) -->
                                    <Border
                                        Grid.Column="1"
                                        Margin="12,0,16,0"
                                        Padding="10,6"
                                        Background="{DynamicResource IntentFlowBgBrush}"
                                        BorderBrush="{DynamicResource IntentFlowBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            x:Name="RelationshipDetectionHintText"
                                            Text="🤖 已结合技能模型与画像特质自动锁定"
                                            FontSize="11"
                                            Foreground="{DynamicResource IntentFlowTextBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 右侧：AI 专家深度破局解读按钮 (独立占用 Column 2，绝对不会被左侧遮挡) -->
                                    <Button
                                        Grid.Column="2"
                                        x:Name="AiConsultationBtn"
                                        Click="AiConsultationBtn_Click"
                                        Style="{StaticResource PrimaryAccentButton}"
                                        Height="34"
                                        Padding="16,0"
                                        Content="✨ AI 专家深度破局解读"
                                        ToolTip="结合全部真实历史与当前提取出的核心维度，以资深专家视角生成通俗犀利的实操破局锦囊"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!--  AI 专家深度破局解读生成中提示面板  -->
                            <Border
                                x:Name="AiConsultationLoadingPanel"
                                Visibility="Collapsed"
                                Margin="0,0,0,14"
                                Padding="14"
                                Background="{DynamicResource CardSubtleBg}"
                                BorderBrush="{DynamicResource AccentCyan}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="正在以资深专家视角，深度研判真实聊天记录并提炼人情破局锦囊，请稍候..."
                                        FontSize="12"
                                        Foreground="{DynamicResource AccentCyan}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!--  AI 专家独家临场军师锦囊卡片（生成后展示）  -->
                            <Border
                                x:Name="AiConsultationResultCard"
                                Visibility="Collapsed"
                                Margin="0,0,0,14"
                                Padding="16"
                                Background="{DynamicResource CardSubtleBg}"
                                BorderBrush="{DynamicResource AccentPurple}"
                                BorderThickness="1.5"
                                CornerRadius="8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            x:Name="AiConsultationHeaderTitle"
                                            Text="✨ 资深心理与沟通专家 · 独家临场破局军师锦囊"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentPurple}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            x:Name="CopyConsultationBtn"
                                            Click="CopyConsultationBtn_Click"
                                            Style="{StaticResource TopActionButton}"
                                            Height="26"
                                            Padding="10,0"
                                            Content="📋 复制专家锦囊"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="AiConsultationResultText"
                                        Text=""
                                        FontSize="12.5"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap"
                                        LineHeight="22" />
                                </StackPanel>
                            </Border>

                            <!--  模块 1：核心心理/诉求概貌总评  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="14"
                                Background="{DynamicResource IntentFlowBgBrush}"
                                BorderBrush="{DynamicResource IntentFlowBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="StrategyCard1Title"
                                        Text="🎯 核心主导特质 · 心理机制与诉求底色"
                                        FontSize="13.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource IntentFlowTextBrush}"
                                        Margin="0,0,0,6" />
                                    <TextBlock
                                        x:Name="StrategyMindsetOverviewText"
                                        Text="加载中..."
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap"
                                        LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <!--  模块 2：高效共鸣与顺势借力契机  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="14"
                                Background="{DynamicResource IntentStrategyBgBrush}"
                                BorderBrush="{DynamicResource IntentStrategyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="StrategyCard2Title"
                                        Text="✨ 顺势借力抓手 · 同频共鸣法则"
                                        FontSize="13.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource IntentStrategyTextBrush}"
                                        Margin="0,0,0,6" />
                                    <TextBlock
                                        x:Name="StrategyLeveragePointsText"
                                        Text="加载中..."
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap"
                                        LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <!--  模块 3：绝对沟通雷区与避坑警示  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="14"
                                Background="{DynamicResource CardSubtleBg}"
                                BorderBrush="{DynamicResource PillIntentBorderBrush}"
                                BorderThickness="1"
