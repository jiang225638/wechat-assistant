<Window x:Class="WeChatCopilot.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeChat Copilot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="430" Height="690"
        MinWidth="390" MinHeight="550"
        Left="120" Top="120">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 基础色彩与画刷 -->

        <SolidColorBrush x:Key="WindowBgBrush" Color="#FA181824" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#EE222233" />
        <SolidColorBrush x:Key="CardSubtleBgBrush" Color="#771B1B2A" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="GreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6" />

        <!-- 扁平圆角按钮样式 -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作强调按钮样式 -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#4B92FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平圆角开关按钮样式 -->
        <Style x:Key="FluentToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2210B981" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#6610B981" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代输入框样式 -->
        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#221A1A2B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 键盘按键外观样式 -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Window.Resources>

    <!-- 外层卡片边框 -->
    <Border CornerRadius="14" Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 顶部导航与状态 -->
                <RowDefinition Height="Auto" /> <!-- 功能分区 Tab 切换 -->
                <RowDefinition Height="*" />    <!-- 主工作区内容 -->
            </Grid.RowDefinitions>

            <!-- ===================== ROW 0: 顶部标题栏与状态胶囊 ===================== -->
            <StackPanel Grid.Row="0">
                <!-- 顶部主操作栏：标题 + 窗口控制 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 标题栏（固定模式下可按住拖动） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                x:Name="HeaderTitlePanel" Background="Transparent"
                                MouseLeftButtonDown="HeaderTitle_MouseLeftButtonDown">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2563EB" Margin="0,0,8,0">
                            <TextBlock Text="💬" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="微信 Copilot" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="· 聊天副驾" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 右侧控制按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="PinButton" Style="{StaticResource FluentToggleButton}"
                                      Content="📌 吸附中" ToolTip="切换：贴边跟随 / 自由摆放"
                                      Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                      Checked="PinButton_Changed" Unchecked="PinButton_Changed" />
                        <Button x:Name="RelocateButton" Style="{StaticResource FluentButton}"
                                Content="🎯 定位" ToolTip="重新锁定并贴靠微信主窗口"
                                Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="RelocateButton_Click" />
                        <Button x:Name="AiSettingsTopButton" Style="{StaticResource FluentButton}"
                                Content="⚙️" ToolTip="打开 AI 模型与服务设置"
                                Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="AiSettingsButton_Click" />
                        <Button x:Name="QuitButton" Style="{StaticResource FluentButton}"
                                Content="✕" ToolTip="退出程序"
                                Padding="8,4" FontSize="11" Foreground="#FF8888" Click="QuitButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- 微信连接状态胶囊栏 -->
                <Border Background="{StaticResource CardSubtleBgBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="10,6" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：微信当前聊天连接指示 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Text="正在查找微信窗口..."
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 右侧：展开底层诊断信息 -->
                        <ToggleButton x:Name="DiagToggle" Grid.Column="1" Content="诊断 ▾"
                                      Style="{StaticResource FluentToggleButton}" FontSize="10" Padding="6,2"
                                      Checked="DiagToggle_Changed" Unchecked="DiagToggle_Changed" />
                    </Grid>
                </Border>

                <!-- 折叠的底层诊断面板 -->
                <Border x:Name="DiagPanel" Visibility="Collapsed"
                        Background="#1A1A28" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="8" Margin="0,6,0,0">
                    <TextBlock x:Name="BoundsText" Text="句柄检测中..."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- ===================== ROW 1: 功能分区 TAB 标签（强制单行排列，防折行） ===================== -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0,10,0,0"
                        Background="Transparent" BorderThickness="0"
                        SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="#1C1C2A" CornerRadius="8" Padding="3"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <UniformGrid Rows="1" IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="4,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tabBorder" Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}" Margin="1,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="💬 当前对话" x:Name="TabChat" ToolTip="微信当前会话及OCR原文" />
                <TabItem Header="✨ AI 建议" x:Name="TabAi" ToolTip="多风格回复建议与潜台词分析" />
                <TabItem Header="👤 人格画像" x:Name="TabPersona" ToolTip="联系人七维特质与沟通偏好" />
                <TabItem Header="❓ 快捷帮助" x:Name="TabHelp" ToolTip="快捷键与使用说明" />
            </TabControl>

            <!-- ===================== ROW 2: 工作区主体视图 ===================== -->
            <Grid Grid.Row="2" Margin="0,8,0,0">

                <!-- VIEW 0: 对话 TAB 内容 -->
                <Grid x:Name="ViewChat" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 操作栏 -->
                        <RowDefinition Height="*" />    <!-- 气泡消息列表 -->
                    </Grid.RowDefinitions>

                    <!-- 操作栏 -->
                    <Border Grid.Row="0" Background="{StaticResource CardSubtleBgBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ReadButton" Grid.Column="0" Content="⚡ 读取当前对话"
                                    Style="{StaticResource PrimaryAccentButton}" Click="ReadButton_Click" />
                            <ToggleButton x:Name="AutoReadButton" Grid.Column="1" Content="自动读取: 关"
                                          Style="{StaticResource FluentToggleButton}" Margin="8,0,0,0"
                                          Checked="AutoReadButton_Changed" Unchecked="AutoReadButton_Changed" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="ClearButton" Content="清空" Style="{StaticResource FluentButton}"
                                        Padding="10,6" Margin="0,0,6,0" Click="ClearButton_Click" />
                                <Button x:Name="OcrButton" Content="整窗OCR" Style="{StaticResource FluentButton}"
                                        Padding="8,6" ToolTip="直接整窗全量识别（调试底层文本）" Click="OcrButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 聊天气泡列表视图 -->
                    <Grid Grid.Row="1">
                        <!-- 空白占位指引 -->
                        <Border x:Name="ChatEmptyPlaceholder" Visibility="Visible"
                                Background="{StaticResource CardSubtleBgBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="20" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="对话缓冲为空" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="点击上方【⚡ 读取当前对话】或开启【自动读取】，助手将对当前微信窗口进行气泡级识读与左右归属分类。"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- 真实气泡列表 -->
                        <ScrollViewer x:Name="ChatScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ChatBubbleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <!-- 根据左右收发方向自动对齐 -->
                                            <Border HorizontalAlignment="{Binding BubbleAlignment}"
                                                    MaxWidth="340" CornerRadius="10"
                                                    Background="{Binding BubbleBackground}"
                                                    BorderBrush="{Binding BubbleBorder}" BorderThickness="1"
                                                    Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SenderLabel}"
                                                               Foreground="{Binding BadgeForeground}"
                                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- OCR 原文调试视图 -->
                        <TextBox x:Name="OcrOutput" Visibility="Collapsed"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                 Background="#FF13131F" Foreground="#FFD4D4D4"
                                 BorderBrush="{StaticResource BorderSubtleBrush}" Padding="8" />
                    </Grid>
                </Grid>

                <!-- VIEW 1: AI 建议 TAB 内容 (一体化合并展示) -->
                <Grid x:Name="ViewAi" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 顶部参数与生成操作行 -->
                        <RowDefinition Height="Auto" /> <!-- 状态进度条 -->
                        <RowDefinition Height="*" />    <!-- 合并后的一体化滚动展示区 -->
                    </Grid.RowDefinitions>

                    <!-- 顶部操作栏 -->
                    <Border Grid.Row="0" Background="{StaticResource CardSubtleBgBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="10,9" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第 1 行：对象信息与关系定位 -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：当前分析对象与画像徽章 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="分析对象:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock x:Name="AiTargetContactText" Text="当前对话好友" FontWeight="Bold" Foreground="#60A5FA" FontSize="11.5" VerticalAlignment="Center" />
                                    <Border x:Name="AiPersonaBadge" Margin="8,0,0,0" Background="#2210B981" BorderBrush="#4410B981" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="AiPersonaBadgeText" Text="已融入画像" Foreground="#10B981" FontSize="10" />
                                    </Border>
                                </StackPanel>

                                <!-- 右侧：关系定位输入/选择框 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="关系:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox x:Name="RelationshipBox" IsEditable="True" Width="138" Height="32" Text="🤖 智能推断"
                                              FontSize="11.5" VerticalContentAlignment="Center"
                                              ToolTip="支持直接输入任意自定义关系（如'刚加上的相亲对象'、'严肃领导'、'冷战中女友'），也可点击下拉选择常用预设">
                                        <ComboBoxItem Content="🤖 智能推断" Tag="智能推断" />
                                        <ComboBoxItem Content="❤️ 追求 / 恋爱心仪" Tag="追求/心仪" />
                                        <ComboBoxItem Content="💼 职场 / 同事汇报" Tag="职场/同事" />
                                        <ComboBoxItem Content="🍻 亲密 / 死党好友" Tag="亲密好友" />
                                        <ComboBoxItem Content="🤝 商务 / 客户合作" Tag="商务/客户" />
                                        <ComboBoxItem Content="❄️ 矛盾 / 冷战挽回" Tag="冷战/挽回" />
                                        <ComboBoxItem Content="🌹 相亲 / 刚加好友" Tag="相亲/初识" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- 第 2 行：参数与生成按钮（严格同一行水平对齐，高度均为 32px） -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：融入画像与候选数 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="IncludePersonaCheck" Content="融入人格画像" IsChecked="True"
                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="候选:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="2,0,4,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CountBox" Width="68" Height="32" SelectedIndex="0" FontSize="11.5"
                                              VerticalContentAlignment="Center" VerticalAlignment="Center">
                                        <ComboBoxItem Content="3 条" IsSelected="True" />
                                        <ComboBoxItem Content="5 条" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- 右侧：智能分析与建议按钮（高度 32px，与左侧控件绝对居中对齐） -->
                                <Button x:Name="GenerateButton" Grid.Column="1" Content="🚀 智能分析与建议"
                                        Style="{StaticResource PrimaryAccentButton}" Height="32" Padding="14,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Click="GenerateButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 生成中状态条 -->
                    <Border x:Name="AiStatusBanner" Grid.Row="1" Visibility="Collapsed"
                            Background="#223B82F6" CornerRadius="6" BorderBrush="#553B82F6" BorderThickness="1"
                            Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressBar Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" />
                            <TextBlock x:Name="AiStatusText" Text="AI 正在结合对方画像深度剖析意图并生成回复建议..."
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 一体化展示区 -->
                    <ScrollViewer x:Name="UnifiedAiScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UnifiedAiContainer">
                            <!-- 空状态占位 -->
                            <Border x:Name="AiEmptyPlaceholder" Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    Padding="20" Margin="0,20,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💡" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="智能副驾已就绪" FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="点击上方【🚀 智能分析与建议】，AI 将深度穿透对方人格画像与最新发言，一网打尽「意图与潜台词洞察」与「多风格回复方案」。"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <!-- 结果面板 (默认折叠，生成后显示) -->
                            <StackPanel x:Name="AiResultPanel" Visibility="Collapsed">
                                <!-- 卡片 1: 对方最新发言与意图剖析 -->
                                <Border Background="#1C2136" CornerRadius="10" BorderBrush="#3B4B75" BorderThickness="1"
                                        Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- 标头 -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔍" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="对方最新发言与意图剖析" FontWeight="Bold" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#333B82F6" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="SubtextTargetAuthor" Text="对方原话" Foreground="#60A5FA" FontSize="10" />
                                            </Border>
                                        </Grid>

                                        <!-- 对方原话引用气泡 -->
                                        <Border Background="#2A3352" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <TextBlock x:Name="SubtextTargetText" Text="“原话”" Foreground="#F3F4F6"
                                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18" />
                                        </Border>

                                        <!-- 潜台词洞察 -->
                                        <Border Background="#231F3D" CornerRadius="6" BorderBrush="#558B5CF6" BorderThickness="1"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="💡 潜台词洞察（弦外之音）" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="SubtextSubtextText" Foreground="#EDE9FE" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 真实心理诉求 -->
                                        <Border Background="#1E293B" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="🎯 真实心理诉求" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="SubtextIntentText" Foreground="#E2E8F0" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 破局建议策略 -->
                                        <Border Background="#182E2B" CornerRadius="6" BorderBrush="#3310B981" BorderThickness="1"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="⚡ 破局沟通策略与避坑指南" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold" />
                                                <TextBlock x:Name="SubtextStrategyText" Foreground="#D1FAE5" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2: 精选回复方案 -->
                                <Border Margin="0,4,0,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                            <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="多风格回复建议" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="(点击「复制」可直接粘贴发微信)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ItemsControl x:Name="SuggestionCards">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                            Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Border HorizontalAlignment="Left" Background="#223B82F6" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Tone}" Foreground="#60A5FA"
                                                                               FontWeight="Bold" FontSize="11" />
                                                                </Border>
                                                                <Button Content="📋 复制" HorizontalAlignment="Right"
                                                                        Style="{StaticResource FluentButton}" Padding="8,3" FontSize="11"
                                                                        Click="CopySuggestion_Click" Tag="{Binding Text}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                                                            <TextBlock Text="{Binding ReasonLine}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: 人格画像 TAB 内容 -->
                <Grid x:Name="ViewPersona" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 联系人选择条 -->
                        <RowDefinition Height="Auto" /> <!-- 操作按钮栏 -->
                        <RowDefinition Height="Auto" /> <!-- 状态与提示横条 -->
                        <RowDefinition Height="*" />    <!-- 画像特质展示区 -->
                    </Grid.RowDefinitions>

                    <!-- 聊天好友选择与已存画像档案切换栏 -->
                    <Border Grid.Row="0" Background="{StaticResource CardSubtleBgBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第 1 行：正在沟通的好友目标 -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="对方好友:" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="ContactBox" Grid.Column="1" Style="{StaticResource FluentTextBox}"
                                         ToolTip="当前分析的微信好友备注名（AI将基于对方的历史发言提炼其性格特征）"
                                         TextChanged="ContactBox_TextChanged" />
                                <Button x:Name="SyncContactButton" Grid.Column="2" Content="🔄 同步当前聊天"
                                        Style="{StaticResource FluentButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0"
                                        Click="SyncContactButton_Click" ToolTip="自动读取微信主窗口当前正在聊天的联系人" />
                            </Grid>

                            <!-- 第 2 行：已保存画像档案库切换 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="已存档案:" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="SavedPersonasCombo" Grid.Column="1"
                                          ToolTip="快速切换查看历史已分析并保存的好友画像档案"
                                          SelectionChanged="SavedPersonasCombo_SelectionChanged" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 操作按钮栏 (拉取 / 蒸馏 / 导入) -->
                    <Border Grid.Row="1" Background="{StaticResource CardSubtleBgBrush}"
                            CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="FetchHistoryButton" Grid.Column="0" Content="⚡ 拉取 TraceMemo"
                                    Style="{StaticResource PrimaryAccentButton}" Margin="0,0,4,0"
                                    Click="FetchHistoryButton_Click" ToolTip="从本机 TraceMemo (端口 6131) 拉取完整历史" />
                            <Button x:Name="DistillButton" Grid.Column="1" Content="✨ 蒸馏/更新画像"
                                    Style="{StaticResource FluentButton}" FontWeight="Bold" Margin="4,0,4,0"
                                    Click="DistillButton_Click" ToolTip="根据历史记录提炼结构化七维画像" />
                            <Button x:Name="ImportCsvButton" Grid.Column="2" Content="📥 导入CSV"
                                    Style="{StaticResource FluentButton}" Padding="10,6" Margin="4,0,0,0"
                                    Click="ImportCsvButton_Click" ToolTip="从导出的 CSV 文件手动载入历史" />
                        </Grid>
                    </Border>

                    <!-- 状态与历史信息横条 -->
                    <Border x:Name="PersonaStatusCard" Grid.Row="2"
                            Background="#1F2433" CornerRadius="6" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PersonaStatusText" Text="就绪：请先拉取 TraceMemo 或导入历史记录"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ProgressBar x:Name="PersonaProgress" Grid.Column="1" Width="50" Height="4"
                                         IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 画像结果展示区 -->
                    <Grid Grid.Row="3">
                        <!-- 空画像提示指引卡片 -->
                        <Border x:Name="PersonaEmptyCard" Visibility="Visible"
                                Background="{StaticResource CardSubtleBgBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="20" VerticalAlignment="Center" Margin="10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock x:Name="PersonaEmptyTitle" Text="暂无此人画像" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="点击【⚡ 拉取 TraceMemo】将自动检索本地微信数据库历史；&#x0a;获取历史后点击【✨ 蒸馏/更新画像】，AI 将深度提取七维画像并持久化保存。"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- 画像卡片容器 -->
                        <ScrollViewer x:Name="PersonaScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 画像概要头卡片 -->
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                        Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PersonaHeaderName" Text="联系人画像"
                                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="PersonaHeaderMeta" Text="更新时间: --  |  历史消息: 0 条"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button x:Name="DeletePersonaButton" Grid.Column="1" Content="🗑️ 清除"
                                                Style="{StaticResource FluentButton}" Padding="6,2" FontSize="10"
                                                Click="DeletePersonaButton_Click" ToolTip="删除本画像记录" />
                                    </Grid>
                                </Border>

                                <!-- 专业多维性格与沟通雷达图谱卡片 -->
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                        Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="多维性格与沟通雷达图谱" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="量化特征图谱" HorizontalAlignment="Right" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Canvas x:Name="RadarCanvas" Width="360" Height="200" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 七维特质卡片 ItemsControl -->
                                <ItemsControl x:Name="PersonaCards">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                                    Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <!-- 头部：维度名称 + 评分 + 置信度进度条 -->
                                                    <Grid>
                                                        <Border HorizontalAlignment="Left" Background="#2210B981" CornerRadius="4" Padding="6,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Dimension}" Foreground="#34D399"
                                                                           FontWeight="Bold" FontSize="11" />
                                                                <TextBlock Text=" · " Foreground="#6634D399" FontSize="11" />
                                                                <TextBlock Text="{Binding ScoreText}" Foreground="#A7F3D0"
                                                                           FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="置信度: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                            <TextBlock Text="{Binding ConfidencePercentText}" Foreground="#34D399"
                                                                        FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" />
                                                            <ProgressBar Width="50" Height="5" Maximum="100"
                                                                         Value="{Binding ConfidencePercent, Mode=OneWay}"
                                                                         Foreground="{StaticResource GreenBrush}"
                                                                         Background="#33FFFFFF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 特质描述 (推断层) -->
                                                    <TextBlock Text="{Binding Attribute}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />

                                                    <!-- 证据原话 (观察层，折叠显示) -->
                                                    <Expander Header="{Binding EvidenceSummary}" Margin="0,6,0,0"
                                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                              Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}">
                                                        <Border Background="#1A1A28" CornerRadius="6" Padding="8" Margin="0,4,0,0">

                                                            <TextBlock Text="{Binding EvidenceText}" Foreground="#D1D5DB"
                                                                       FontSize="11" TextWrapping="Wrap" FontStyle="Italic" LineHeight="17" />
                                                        </Border>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- VIEW 3: 帮助 TAB 内容 -->
                <Grid x:Name="ViewHelp" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">
                            <!-- 全局热键清单卡片 -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="⌨️ 全局快捷键指南" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="W" Foreground="White" FontSize="10"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="快速显示 / 隐藏悬浮窗" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="D" Foreground="White" FontSize="10"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="立即抓取并读取当前对话气泡" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="E" Foreground="White" FontSize="10"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="重新定位并贴齐微信右侧边缘" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" Foreground="White" FontSize="10"/></Border>
                                            <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}"><TextBlock Text="O" Foreground="White" FontSize="10"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="进行全窗口 OCR 识别（排错使用）" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 设计原则与隐私安全说明卡片 -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="10"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🛡️ 本地优先与隐私安全原则" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="• 只读不代发：本助手绝不会模拟键盘鼠标自动发送消息，完全由您自主确认与复制。&#x0a;• 本地安全：API Key 经 Windows DPAPI 加密保存，仅您当前登录的 Windows 账户能解密。&#x0a;• 风险隔离：历史会话通过本地 TraceMemo 读取，本工具不植入任何微信内存外挂。"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                               TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>

                            <!-- 底端快捷设置按钮 -->
                            <Button Content="⚙️ 打开详细设置（API 密钥 / 模型 / TraceMemo 地址）"
                                    Style="{StaticResource FluentButton}" HorizontalAlignment="Stretch"
                                    Click="AiSettingsButton_Click" Margin="0,4,0,10" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
