<Window
    x:Class="WeChatCopilot.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WeChat Copilot"
    Width="430"
    Height="690"
    MinWidth="390"
    MinHeight="550"
    AllowsTransparency="True"
    Background="Transparent"
    Left="120"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    Top="120"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  基础色彩与画刷  -->

        <SolidColorBrush x:Key="WindowBgBrush" Color="#FA181824" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#EE222233" />
        <SolidColorBrush x:Key="CardSubtleBgBrush" Color="#771B1B2A" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F4F6" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="GreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6" />

        <!--  扁平圆角按钮样式  -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主操作强调按钮样式  -->
        <Style
            x:Key="PrimaryAccentButton"
            BasedOn="{StaticResource FluentButton}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#4B92FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  扁平圆角开关按钮样式  -->
        <Style x:Key="FluentToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2210B981" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#6610B981" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  现代输入框样式  -->
        <Style x:Key="FluentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#221A1A2B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="0"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  键盘按键外观样式  -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!--  设置页子导航 RadioButton 胶囊样式  -->
        <Style x:Key="SettingSubTabRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="SettingsSubGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="subBorder"
                            Margin="1,0"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="subBorder" Property="Background" Value="#2D2B4E" />
                                <Setter Property="Foreground" Value="#60A5FA" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  外层卡片边框  -->
    <Border
        Padding="14"
        Background="{StaticResource WindowBgBrush}"
        BorderBrush="{StaticResource BorderLightBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.45"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  顶部导航与状态  -->
                <RowDefinition Height="Auto" />
                <!--  功能分区 Tab 切换  -->
                <RowDefinition Height="*" />
                <!--  主工作区内容  -->
            </Grid.RowDefinitions>

            <!--  ===================== ROW 0: 顶部标题栏与状态胶囊 =====================  -->
            <StackPanel Grid.Row="0">
                <!--  顶部主操作栏：标题 + 窗口控制  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  标题栏（固定模式下可按住拖动）  -->
                    <StackPanel
                        x:Name="HeaderTitlePanel"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        MouseLeftButtonDown="HeaderTitle_MouseLeftButtonDown"
                        Orientation="Horizontal">
                        <Border
                            Width="24"
                            Height="24"
                            Margin="0,0,8,0"
                            Background="#2563EB"
                            CornerRadius="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="💬" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="微信 Copilot" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="· 聊天副驾" />
                    </StackPanel>

                    <!--  右侧控制按钮组  -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="PinButton"
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Checked="PinButton_Changed"
                            Content="📌 吸附中"
                            FontSize="11"
                            Style="{StaticResource FluentToggleButton}"
                            ToolTip="切换：贴边跟随 / 自由摆放"
                            Unchecked="PinButton_Changed" />
                        <Button
                            x:Name="RelocateButton"
                            Margin="0,0,6,0"
                            Padding="8,4"
                            Click="RelocateButton_Click"
                            Content="🎯 定位"
                            FontSize="11"
                            Style="{StaticResource FluentButton}"
                            ToolTip="重新锁定并贴靠微信主窗口" />
                        <Button
                            x:Name="QuitButton"
                            Padding="8,4"
                            Click="QuitButton_Click"
                            Content="✕"
                            FontSize="11"
                            Foreground="#FF8888"
                            Style="{StaticResource FluentButton}"
                            ToolTip="退出程序" />
                    </StackPanel>
                </Grid>

                <!--  微信连接状态胶囊栏  -->
                <Border
                    Margin="0,10,0,0"
                    Padding="10,6"
                    Background="{StaticResource CardSubtleBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧：微信当前聊天连接指示  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                Fill="{StaticResource GreenBrush}" />
                            <TextBlock
                                x:Name="StatusText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="正在查找微信窗口..." />
                        </StackPanel>

                        <!--  右侧：展开底层诊断信息  -->
                        <ToggleButton
                            x:Name="DiagToggle"
                            Grid.Column="1"
                            Padding="6,2"
                            Checked="DiagToggle_Changed"
                            Content="诊断 ▾"
                            FontSize="10"
                            Style="{StaticResource FluentToggleButton}"
                            Unchecked="DiagToggle_Changed" />
                    </Grid>
                </Border>

                <!--  折叠的底层诊断面板  -->
                <Border
                    x:Name="DiagPanel"
                    Margin="0,6,0,0"
                    Padding="8"
                    Background="#1A1A28"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="BoundsText"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="句柄检测中..."
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!--  ===================== ROW 1: 功能分区 TAB 标签（强制单行排列，防折行） =====================  -->
            <TabControl
                x:Name="MainTabControl"
                Grid.Row="1"
                Margin="0,10,0,0"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border
                            Padding="3"
                            Background="#1C1C2A"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <UniformGrid IsItemsHost="True" Rows="1" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="4,7" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        x:Name="tabBorder"
                                        Margin="1,0"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        CornerRadius="6">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem
                    x:Name="TabChat"
                    Header="💬 对话"
                    ToolTip="微信当前会话及OCR原文" />
                <TabItem
                    x:Name="TabAi"
                    Header="✨ 建议"
                    ToolTip="多风格回复建议与潜台词分析" />
                <TabItem
                    x:Name="TabPersona"
                    Header="👤 画像"
                    ToolTip="联系人认知画像与特质蒸馏" />
                <TabItem
                    x:Name="TabSettings"
                    Header="⚙️ 设置"
                    ToolTip="AI 模型、技能中心、系统偏好与使用指南" />
            </TabControl>

            <!--  ===================== ROW 2: 工作区主体视图 =====================  -->
            <Grid Grid.Row="2" Margin="0,8,0,0">

                <!--  VIEW 0: 对话 TAB 内容  -->
                <Grid x:Name="ViewChat" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  操作栏  -->
                        <RowDefinition Height="*" />
                        <!--  气泡消息列表  -->
                    </Grid.RowDefinitions>

                    <!--  操作栏  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="8"
                        Background="{StaticResource CardSubtleBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ReadButton"
                                Grid.Column="0"
                                Click="ReadButton_Click"
                                Content="⚡ 读取当前对话"
                                Style="{StaticResource PrimaryAccentButton}" />
                            <ToggleButton
                                x:Name="AutoReadButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Checked="AutoReadButton_Changed"
                                Content="自动读取: 关"
                                Style="{StaticResource FluentToggleButton}"
                                Unchecked="AutoReadButton_Changed" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button
                                    x:Name="ClearButton"
                                    Margin="0,0,6,0"
                                    Padding="10,6"
                                    Click="ClearButton_Click"
                                    Content="清空"
                                    Style="{StaticResource FluentButton}" />
                                <Button
                                    x:Name="OcrButton"
                                    Padding="8,6"
                                    Click="OcrButton_Click"
                                    Content="整窗OCR"
                                    Style="{StaticResource FluentButton}"
                                    ToolTip="直接整窗全量识别（调试底层文本）" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  聊天气泡列表视图  -->
                    <Grid Grid.Row="1">
                        <!--  空白占位指引  -->
                        <Border
                            x:Name="ChatEmptyPlaceholder"
                            Margin="10,0"
                            Padding="20"
                            VerticalAlignment="Center"
                            Background="{StaticResource CardSubtleBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Text="💬" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="对话缓冲为空" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    LineHeight="18"
                                    Text="点击上方【⚡ 读取当前对话】或开启【自动读取】，助手将对当前微信窗口进行气泡级识读与左右归属分类。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  真实气泡列表  -->
                        <ScrollViewer
                            x:Name="ChatScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <ItemsControl x:Name="ChatBubbleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <!--  根据左右收发方向自动对齐  -->
                                            <Border
                                                MaxWidth="340"
                                                Padding="10,8"
                                                HorizontalAlignment="{Binding BubbleAlignment}"
                                                Background="{Binding BubbleBackground}"
                                                BorderBrush="{Binding BubbleBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock
                                                        Margin="0,0,0,4"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding BadgeForeground}"
                                                        Text="{Binding SenderLabel}" />
                                                    <TextBlock
                                                        FontSize="12.5"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        LineHeight="18"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--  OCR 原文调试视图  -->
                        <TextBox
                            x:Name="OcrOutput"
                            Padding="8"
                            AcceptsReturn="True"
                            Background="#FF13131F"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            FontSize="11"
                            Foreground="#FFD4D4D4"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!--  VIEW 1: AI 建议 TAB 内容 (一体化合并展示)  -->
                <Grid x:Name="ViewAi" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  顶部参数与生成操作行  -->
                        <RowDefinition Height="Auto" />
                        <!--  状态进度条  -->
                        <RowDefinition Height="*" />
                        <!--  合并后的一体化滚动展示区  -->
                    </Grid.RowDefinitions>

                    <!--  顶部操作栏  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10,9"
                        Background="{StaticResource CardSubtleBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  第 1 行：对象信息与关系定位  -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧：当前分析对象与画像徽章  -->
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="分析对象:" />
                                    <TextBlock
                                        x:Name="AiTargetContactText"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Foreground="#60A5FA"
                                        Text="当前对话好友" />
                                    <Border
                                        x:Name="AiPersonaBadge"
                                        Margin="8,0,0,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="#2210B981"
                                        BorderBrush="#4410B981"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="AiPersonaBadgeText"
                                            FontSize="10"
                                            Foreground="#10B981"
                                            Text="已融入画像" />
                                    </Border>
                                    <Border
                                        x:Name="AiSkillBadge"
                                        Margin="6,0,0,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="#2038BDF8"
                                        BorderBrush="#4438BDF8"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            x:Name="AiTopSkillText"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="#38BDF8"
                                            Text="🧬 女娲心智蒸馏"
                                            ToolTip="当前全局生效的沟通作战策略 Skill（在 设置-&gt;技能中心 切换）" />
                                    </Border>
                                </StackPanel>

                                <!--  右侧：关系定位输入/选择框  -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="关系:" />
                                    <ComboBox
                                        x:Name="RelationshipBox"
                                        Width="138"
                                        Height="32"
                                        VerticalContentAlignment="Center"
                                        FontSize="11.5"
                                        IsEditable="True"
                                        Text="🤖 智能推断"
                                        ToolTip="支持直接输入任意自定义关系（如'刚加上的相亲对象'、'严肃领导'、'冷战中女友'），也可点击下拉选择常用预设">
                                        <ComboBoxItem Content="🤖 智能推断" Tag="智能推断" />
                                        <ComboBoxItem Content="❤️ 追求 / 恋爱心仪" Tag="追求/心仪" />
                                        <ComboBoxItem Content="💼 职场 / 同事汇报" Tag="职场/同事" />
                                        <ComboBoxItem Content="🍻 亲密 / 死党好友" Tag="亲密好友" />
                                        <ComboBoxItem Content="🤝 商务 / 客户合作" Tag="商务/客户" />
                                        <ComboBoxItem Content="❄️ 矛盾 / 冷战挽回" Tag="冷战/挽回" />
                                        <ComboBoxItem Content="🌹 相亲 / 刚加好友" Tag="相亲/初识" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!--  第 2 行：策略 Skill、候选条数、融入画像与生成按钮（严格同一行水平对齐，高度均为 32px）  -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧：候选条数与画像选项  -->
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="候选条数:" />
                                    <ComboBox
                                        x:Name="CountBox"
                                        Width="82"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Padding="8,0,22,0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        FontSize="11.5"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="3 条" IsSelected="True" />
                                        <ComboBoxItem Content="5 条" />
                                    </ComboBox>
                                    <CheckBox
                                        x:Name="IncludePersonaCheck"
                                        VerticalAlignment="Center"
                                        Content="融入画像"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        IsChecked="True"
                                        ToolTip="勾选后将融入该联系人的深度心智画像（心智模型、决策启发式、反模式雷区等）" />
                                </StackPanel>

                                <!--  右侧：智能分析与建议按钮（高度 32px，与左侧控件绝对居中对齐）  -->
                                <Button
                                    x:Name="GenerateButton"
                                    Grid.Column="1"
                                    Height="32"
                                    Padding="12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="GenerateButton_Click"
                                    Content="🚀 智能分析"
                                    Style="{StaticResource PrimaryAccentButton}"
                                    ToolTip="结合当前策略 Skill 与对方画像，一键生成意图剖析与针对性回复建议" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  建议 TAB：生成状态与提示卡片（自适应防溢出，支持长文本自动换行）  -->
                    <Border
                        x:Name="AiStatusBanner"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Background="#223B82F6"
                        BorderBrush="#553B82F6"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  顶部极窄线条循环滚动进度条 (高度 2px，仅在分析加载中显示)  -->
                            <ProgressBar
                                x:Name="AiStatusProgress"
                                Grid.Row="0"
                                Height="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}"
                                IsIndeterminate="True"
                                Visibility="Visible" />

                            <!--  提示与错误内容区 (自动换行，左右内边距防御，绝不溢出)  -->
                            <Grid Grid.Row="1" Margin="10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="AiStatusIcon"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Text="⚡" />

                                <ScrollViewer
                                    Grid.Column="1"
                                    MaxHeight="80"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="AiStatusText"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        LineHeight="16"
                                        Text="AI 正在结合当前作战策略与对方画像深度剖析意图并生成回复建议..."
                                        TextWrapping="Wrap" />
                                </ScrollViewer>

                                <Button
                                    x:Name="AiStatusDismissBtn"
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Padding="4,1"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="AiStatusDismiss_Click"
                                    Content="✕"
                                    Cursor="Hand"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    ToolTip="关闭提示"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  一体化展示区  -->
                    <ScrollViewer
                        x:Name="UnifiedAiScroll"
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UnifiedAiContainer">
                            <!--  空状态占位  -->
                            <Border
                                x:Name="AiEmptyPlaceholder"
                                Margin="0,20,0,0"
                                Padding="20"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        FontSize="36"
                                        Text="💡" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="智能副驾已就绪" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        LineHeight="18"
                                        Text="在上方选取专属【策略 Skill】并点击【🚀 智能分析】，AI 将深度穿透对方人格画像与最新发言，一网打尽「意图剖析」与「实战回复方案」。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  结果面板 (默认折叠，生成后显示)  -->
                            <StackPanel x:Name="AiResultPanel" Visibility="Collapsed">
                                <!--  卡片 1: 对方最新发言与意图剖析  -->
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    Background="#1C2136"
                                    BorderBrush="#3B4B75"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <!--  标头  -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="🔍" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#93C5FD"
                                                    Text="对方最新发言与意图剖析" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Border
                                                    x:Name="AiAppliedSkillBadge"
                                                    Margin="0,0,6,0"
                                                    Padding="6,2"
                                                    Background="#258B5CF6"
                                                    BorderBrush="#558B5CF6"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="AiAppliedSkillText"
                                                        FontSize="10"
                                                        Foreground="#C4B5FD"
                                                        Text="🧬 女娲心智" />
                                                </Border>
                                                <Border
                                                    Padding="6,2"
                                                    Background="#333B82F6"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="SubtextTargetAuthor"
                                                        FontSize="10"
                                                        Foreground="#60A5FA"
                                                        Text="对方原话" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!--  对方原话引用气泡  -->
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10,8"
                                            Background="#2A3352"
                                            CornerRadius="6">
                                            <TextBlock
                                                x:Name="SubtextTargetText"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="#F3F4F6"
                                                LineHeight="18"
                                                Text="“原话”"
                                                TextWrapping="Wrap" />
                                        </Border>

                                        <!--  潜台词洞察  -->
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="#231F3D"
                                            BorderBrush="#558B5CF6"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#C4B5FD"
                                                    Text="💡 潜台词洞察（弦外之音）" />
                                                <TextBlock
                                                    x:Name="SubtextSubtextText"
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="#EDE9FE"
                                                    LineHeight="18"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  真实心理诉求  -->
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="#1E293B"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#94A3B8"
                                                    Text="🎯 真实心理诉求" />
                                                <TextBlock
                                                    x:Name="SubtextIntentText"
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="#E2E8F0"
                                                    LineHeight="18"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  破局建议策略  -->
                                        <Border
                                            Padding="10,8"
                                            Background="#182E2B"
                                            BorderBrush="#3310B981"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock
                                                    x:Name="SubtextStrategyTitle"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#6EE7B7"
                                                    Text="⚡ 破局沟通策略与避坑指南" />
                                                <TextBlock
                                                    x:Name="SubtextStrategyText"
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="#D1FAE5"
                                                    LineHeight="18"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!--  卡片 2: 精选回复方案  -->
                                <Border Margin="0,4,0,4">
                                    <StackPanel>
                                        <StackPanel Margin="2,0,0,8" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="💬" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="多风格回复建议" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="(点击「复制」可直接粘贴发微信)" />
                                        </StackPanel>

                                        <ItemsControl x:Name="SuggestionCards">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="12"
                                                        Background="{StaticResource CardBgBrush}"
                                                        BorderBrush="{StaticResource BorderLightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Border
                                                                    Padding="6,2"
                                                                    HorizontalAlignment="Left"
                                                                    Background="#223B82F6"
                                                                    CornerRadius="4">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="Bold"
                                                                        Foreground="#60A5FA"
                                                                        Text="{Binding Tone}" />
                                                                </Border>
                                                                <Button
                                                                    Padding="8,3"
                                                                    HorizontalAlignment="Right"
                                                                    Click="CopySuggestion_Click"
                                                                    Content="📋 复制"
                                                                    FontSize="11"
                                                                    Style="{StaticResource FluentButton}"
                                                                    Tag="{Binding Text}" />
                                                            </Grid>
                                                            <TextBlock
                                                                Margin="0,8,0,0"
                                                                FontSize="13"
                                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                LineHeight="19"
                                                                Text="{Binding Text}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,6,0,0"
                                                                FontSize="11"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="{Binding ReasonLine}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  VIEW 2: 人格画像 TAB 内容  -->
                <Grid x:Name="ViewPersona" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  联系人选择栏  -->
                        <RowDefinition Height="Auto" />
                        <!--  操作按钮栏  -->
                        <RowDefinition Height="Auto" />
                        <!--  状态与提示横条  -->
                        <RowDefinition Height="*" />
                        <!--  画像特质展示区  -->
                    </Grid.RowDefinitions>

                    <!--  聊天好友选择与已存档案切换栏  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10,8"
                        Background="{StaticResource CardSubtleBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <!--  第一行：已存档案快速切换（独占整行，超宽展示，杜绝文字截断）  -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="已保存画像:" />
                                <ComboBox
                                    x:Name="SavedPersonasCombo"
                                    Grid.Column="1"
                                    Height="28"
                                    Padding="8,0,24,0"
                                    VerticalContentAlignment="Center"
                                    FontSize="11.5"
                                    SelectionChanged="SavedPersonasCombo_SelectionChanged"
                                    ToolTip="已保存画像的好友档案库，点击一键载入" />
                            </Grid>

                            <!--  第二行：选择好友输入框 与 获取当前聊天对象姓名按钮  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="选择好友:" />
                                <TextBox
                                    x:Name="ContactBox"
                                    Grid.Column="1"
                                    Height="28"
                                    FontSize="11.5"
                                    Style="{StaticResource FluentTextBox}"
                                    TextChanged="ContactBox_TextChanged"
                                    ToolTip="当前分析的微信好友备注名（可直接手动输入，也可点击右侧按钮自动获取）" />
                                <Button
                                    x:Name="SyncContactButton"
                                    Grid.Column="2"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    Padding="8,3"
                                    Click="SyncContactButton_Click"
                                    Content="🔍 获取当前聊天对象"
                                    FontSize="11"
                                    Style="{StaticResource FluentButton}"
                                    ToolTip="自动识别并填入微信主窗口当前正在聊天的联系人" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  操作按钮栏 (一键蒸馏 / 刷新历史 / 导入CSV)  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="8"
                        Background="{StaticResource CardSubtleBgBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="DistillButton"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                Click="DistillButton_Click"
                                Content="✨ 一键蒸馏画像"
                                FontWeight="Bold"
                                Style="{StaticResource PrimaryAccentButton}"
                                ToolTip="一步到位：若无历史自动拉取 TraceMemo，基于所选 Skill 提炼结构化认知画像" />
                            <Button
                                x:Name="FetchHistoryButton"
                                Grid.Column="1"
                                Margin="2,0,2,0"
                                Click="FetchHistoryButton_Click"
                                Content="⚡ 刷新历史"
                                Style="{StaticResource FluentButton}"
                                ToolTip="从本机 TraceMemo (端口 6131) 重新拉取当前联系人的聊天历史" />
                            <Button
                                x:Name="ImportCsvButton"
                                Grid.Column="2"
                                Margin="2,0,0,0"
                                Click="ImportCsvButton_Click"
                                Content="📥 导入CSV"
                                Style="{StaticResource FluentButton}"
                                ToolTip="从导出的 CSV 文件手动载入历史" />
                        </Grid>
                    </Border>

                    <!--  状态与历史信息横条（顶部极窄进度条循环滚动，下方文本自适应展开）  -->
                    <Border
                        x:Name="PersonaStatusCard"
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        Background="#1F2433"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  顶部极窄线条循环滚动进度条 (高度 2px，仅在分析加载中循环滚动，置于卡片顶端边缘)  -->
                            <ProgressBar
                                x:Name="PersonaProgress"
                                Grid.Row="0"
                                Height="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />

                            <!--  状态文本：独享整行横向空间，支持多行自动换行  -->
                            <TextBlock
                                x:Name="PersonaStatusText"
                                Grid.Row="1"
                                Margin="10,6"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                LineHeight="16"
                                Text="就绪：请先输入或同步好友，点击【✨ 一键蒸馏画像】"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!--  画像结果展示区  -->
                    <Grid Grid.Row="3">
                        <!--  空画像提示指引卡片  -->
                        <Border
                            x:Name="PersonaEmptyCard"
                            Margin="10,0"
                            Padding="20"
                            VerticalAlignment="Center"
                            Background="{StaticResource CardSubtleBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    Text="👤" />
                                <TextBlock
                                    x:Name="PersonaEmptyTitle"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="暂无此人画像" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    LineHeight="18"
                                    Text="点击【⚡ 拉取 TraceMemo】将自动检索本地微信数据库历史；&#x0a;获取历史后点击【✨ 蒸馏/更新画像】，AI 将基于女娲 (Nuwa Skill) 心智蒸馏方法论，深度提炼心智模型、决策启发式、表达DNA等认知操作系统全景。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  画像卡片容器  -->
                        <ScrollViewer
                            x:Name="PersonaScroll"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel>
                                <!--  画像概要头卡片  -->
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12,10"
                                    Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                x:Name="PersonaHeaderName"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="联系人画像" />
                                            <TextBlock
                                                x:Name="PersonaHeaderMeta"
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="更新时间: --  |  历史消息: 0 条" />
                                        </StackPanel>
                                        <Button
                                            x:Name="DeletePersonaButton"
                                            Grid.Column="1"
                                            Padding="6,2"
                                            Click="DeletePersonaButton_Click"
                                            Content="🗑️ 清除"
                                            FontSize="10"
                                            Style="{StaticResource FluentButton}"
                                            ToolTip="删除本画像记录" />
                                    </Grid>
                                </Border>

                                <!--  专业多维性格与沟通雷达图谱卡片  -->
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12,10"
                                    Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="📊" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="多维性格与沟通雷达图谱" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Border
                                                    Padding="6,2"
                                                    Background="#2038BDF8"
                                                    BorderBrush="#5038BDF8"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        x:Name="RadarSkillBadgeText"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#38BDF8"
                                                        Text="🧬 女娲心智蒸馏 (Nuwa Skill)" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Canvas
                                            x:Name="RadarCanvas"
                                            Width="360"
                                            Height="200"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!--  七维特质卡片 ItemsControl  -->
                                <ItemsControl x:Name="PersonaCards">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                Background="{StaticResource CardBgBrush}"
                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel>
                                                    <!--  头部：维度名称 + 专属分类Tag + 评分 + 可信度进度条 (双列布局，杜绝重叠与文字溢出)  -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  左侧：维度与评分徽章 + 专属方法论徽章（自适应换行与文本截断）  -->
                                                        <WrapPanel
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                            <Border
                                                                Margin="0,0,6,2"
                                                                Padding="6,2"
                                                                HorizontalAlignment="Left"
                                                                Background="#2210B981"
                                                                CornerRadius="4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        MaxWidth="140"
                                                                        FontSize="11"
                                                                        FontWeight="Bold"
                                                                        Foreground="#34D399"
                                                                        Text="{Binding Dimension}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip="{Binding Dimension}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="#6634D399"
                                                                        Text=" · " />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#A7F3D0"
                                                                        Text="{Binding ScoreText}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!--  专属分类方法论标签 (仅在具有专属方法论标签时显示，若无/重复维度名则自动隐藏)  -->
                                                            <Border
                                                                Margin="0,0,6,2"
                                                                Padding="5,1"
                                                                Background="#1E293B"
                                                                BorderBrush="#4038BDF8"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Visibility="{Binding CategoryTagVisibility}">
                                                                <TextBlock
                                                                    MaxWidth="100"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#38BDF8"
                                                                    Text="{Binding NuwaTag}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding NuwaTag}" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <!--  右侧：可信度与进度条（独立列锁定，绝不重叠）  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="可信度: " />
                                                            <TextBlock
                                                                Margin="0,0,6,0"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="#34D399"
                                                                Text="{Binding ConfidencePercentText}" />
                                                            <ProgressBar
                                                                Width="46"
                                                                Height="5"
                                                                VerticalAlignment="Center"
                                                                Background="#33FFFFFF"
                                                                Foreground="{StaticResource GreenBrush}"
                                                                Maximum="100"
                                                                Value="{Binding ConfidencePercent, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  特质描述 (推断层)  -->
                                                    <TextBlock
                                                        Margin="0,8,0,0"
                                                        FontSize="13"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        LineHeight="19"
                                                        Text="{Binding Attribute}"
                                                        TextWrapping="Wrap" />

                                                    <!--  证据原话 (观察层，折叠显示)  -->
                                                    <Expander
                                                        Margin="0,6,0,0"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Header="{Binding EvidenceSummary}"
                                                        Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}">
                                                        <Border
                                                            Margin="0,4,0,0"
                                                            Padding="8"
                                                            Background="#1A1A28"
                                                            CornerRadius="6">

                                                            <TextBlock
                                                                FontSize="11"
                                                                FontStyle="Italic"
                                                                Foreground="#D1D5DB"
                                                                LineHeight="17"
                                                                Text="{Binding EvidenceText}"
                                                                TextWrapping="Wrap" />
                                                        </Border>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!--  VIEW 3: 设置 TAB 内容 (集成 AI模型、技能中心、系统偏好与使用指南 4 大子分类)  -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  子分类切换胶囊栏  -->
                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="3"
                        Background="#181826"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <UniformGrid Rows="1">
                            <RadioButton
                                x:Name="SettingSubTabAi"
                                Click="SettingSubTab_Click"
                                Content="🧠 AI模型"
                                IsChecked="True"
                                Style="{StaticResource SettingSubTabRadio}"
                                Tag="0" />
                            <RadioButton
                                x:Name="SettingSubTabSkill"
                                Click="SettingSubTab_Click"
                                Content="🧬 技能中心"
                                Style="{StaticResource SettingSubTabRadio}"
                                Tag="1" />
                            <RadioButton
                                x:Name="SettingSubTabPref"
                                Click="SettingSubTab_Click"
                                Content="🎨 偏好管理"
                                Style="{StaticResource SettingSubTabRadio}"
                                Tag="2" />
                            <RadioButton
                                x:Name="SettingSubTabHelp"
                                Click="SettingSubTab_Click"
                                Content="❓ 使用指南"
                                Style="{StaticResource SettingSubTabRadio}"
                                Tag="3" />
                        </UniformGrid>
                    </Border>

                    <!--  子视图 0: 🧠 AI 模型与服务设置  -->
                    <ScrollViewer
                        x:Name="SettingViewAi"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Visible">
                        <StackPanel Margin="0,0,0,16">
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="🧠 AI 模型与服务设置" />

                                    <!--  接口基址  -->
                                    <TextBlock
                                        Margin="0,10,0,4"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="接口基址 (Endpoint，OpenAI 兼容，含 /v1)：" />
                                    <TextBox
                                        x:Name="SettingEndpointBox"
                                        Height="32"
                                        FontSize="11.5"
                                        Style="{StaticResource FluentTextBox}" />

                                    <!--  模型名称 与 温度  -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="模型名称 (Model)：" />
                                            <TextBox
                                                x:Name="SettingModelBox"
                                                Height="32"
                                                FontSize="11.5"
                                                Style="{StaticResource FluentTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="温度 (0~1)：" />
                                            <TextBox
                                                x:Name="SettingTempBox"
                                                Height="32"
                                                FontSize="11.5"
                                                Style="{StaticResource FluentTextBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  API Key  -->
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="API Key（本机 DPAPI 硬件加密，不落明文）：" />
                                    <PasswordBox
                                        x:Name="SettingKeyBox"
                                        Height="32"
                                        Padding="8,5"
                                        VerticalContentAlignment="Center"
                                        Background="#221A1A2B"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        FontSize="11.5"
                                        Foreground="{StaticResource TextPrimaryBrush}" />

                                    <!--  TraceMemo 基址  -->
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="TraceMemo API 基址（本地历史读取服务）：" />
                                    <TextBox
                                        x:Name="SettingTraceMemoBox"
                                        Height="32"
                                        FontSize="11.5"
                                        Style="{StaticResource FluentTextBox}" />

                                    <!--  测试状态提示卡片  -->
                                    <Border
                                        x:Name="SettingTestResultBorder"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="#222234"
                                        BorderBrush="#3A3A52"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock
                                                    x:Name="SettingTestStatusIcon"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="✅" />
                                                <TextBlock
                                                    x:Name="SettingTestStatusTitle"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="#10B981"
                                                    Text="测试成功" />
                                                <TextBlock
                                                    x:Name="SettingTestLatencyText"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="#9CA3AF"
                                                    Text="(耗时 320ms)" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="SettingTestDetailBox"
                                                MaxHeight="90"
                                                Margin="0,6,0,0"
                                                Padding="6"
                                                Background="#181824"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                FontSize="11"
                                                Foreground="#E5E7EB"
                                                IsReadOnly="True"
                                                TextWrapping="Wrap"
                                                VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </Border>

                                    <!--  按钮行  -->
                                    <Grid Margin="0,12,0,0">
                                        <Button
                                            x:Name="SettingTestAiButton"
                                            Height="32"
                                            Padding="12,0"
                                            HorizontalAlignment="Left"
                                            Click="SettingTestAiButton_Click"
                                            Content="⚡ 测试 AI 响应"
                                            Style="{StaticResource FluentButton}" />
                                        <Button
                                            x:Name="SettingSaveAiButton"
                                            Height="32"
                                            Padding="16,0"
                                            HorizontalAlignment="Right"
                                            Click="SettingSaveAiButton_Click"
                                            Content="💾 保存 AI 设置"
                                            Style="{StaticResource PrimaryAccentButton}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  子视图 1: 🧬 技能中心 (Skill Studio)  -->
                    <ScrollViewer
                        x:Name="SettingViewSkill"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,16">
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="🧬 技能中心 (Skill Studio)" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button
                                                x:Name="SettingImportSkillButton"
                                                Margin="0,0,6,0"
                                                Padding="8,3"
                                                Click="ImportSkillFileButton_Click"
                                                Content="📁 导入SKILL.md"
                                                FontSize="11"
                                                Style="{StaticResource FluentButton}" />
                                            <Button
                                                x:Name="SettingNewSkillButton"
                                                Padding="8,3"
                                                Click="SettingNewSkillButton_Click"
                                                Content="➕ 新增技能"
                                                FontSize="11"
                                                Style="{StaticResource FluentButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Margin="0,6,0,8"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="管理画像蒸馏与聊天回复策略技能（支持女娲、兔导情景流、麦肯锡、职场商业及导入技能）。" />

                                    <!--  全局默认技能  -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="全局默认技能：" />
                                        <ComboBox
                                            x:Name="SettingActiveSkillCombo"
                                            Grid.Column="1"
                                            Height="35"
                                            VerticalContentAlignment="Center"
                                            FontSize="11.5"
                                            SelectionChanged="SettingActiveSkillCombo_SelectionChanged" />
                                    </Grid>

                                    <!--  自定义技能快速添加卡片 (默认折叠)  -->
                                    <Border
                                        x:Name="SettingCustomSkillCard"
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Background="#201C30"
                                        BorderBrush="#448B5CF6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="#C4B5FD"
                                                    Text="➕ 新增自定义认知蒸馏技能" />
                                                <Button
                                                    Padding="6,2"
                                                    HorizontalAlignment="Right"
                                                    Click="SettingCloseSkillEditor_Click"
                                                    Content="✕ 取消"
                                                    FontSize="10.5"
                                                    Style="{StaticResource FluentButton}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="SettingNewSkillIconBox"
                                                    Height="28"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="12"
                                                    Style="{StaticResource FluentTextBox}"
                                                    Text="🏷️" />
                                                <TextBox
                                                    x:Name="SettingNewSkillNameBox"
                                                    Grid.Column="2"
                                                    Height="28"
                                                    FontSize="11.5"
                                                    Style="{StaticResource FluentTextBox}"
                                                    ToolTip="输入技能名称（如：谈判破局流）" />
                                            </Grid>
                                            <TextBox
                                                x:Name="SettingNewSkillDescBox"
                                                Height="28"
                                                Margin="0,0,0,6"
                                                FontSize="11.5"
                                                Style="{StaticResource FluentTextBox}"
                                                ToolTip="输入技能简介" />
                                            <TextBox
                                                x:Name="SettingNewSkillDimensionsBox"
                                                Height="28"
                                                Margin="0,0,0,6"
                                                FontSize="11.5"
                                                Style="{StaticResource FluentTextBox}"
                                                ToolTip="输入雷达图专属评估维度（建议 4~6 个，用逗号或空格隔开，如：框架强度, 需求感管理, 慕强机制, 窗口状态）" />
                                            <TextBox
                                                x:Name="SettingNewSkillPromptBox"
                                                Height="65"
                                                AcceptsReturn="True"
                                                FontSize="11"
                                                Style="{StaticResource FluentTextBox}"
                                                TextWrapping="Wrap"
                                                ToolTip="输入技能核心提示词 (SystemPrompt) 与作战心法" />
                                            <Button
                                                Height="28"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Click="SettingSaveSkillButton_Click"
                                                Content="💾 保存技能"
                                                Style="{StaticResource PrimaryAccentButton}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  已安装技能列表  -->
                                    <ItemsControl x:Name="SettingSkillList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="10,8"
                                                    Background="#1A1A28"
                                                    BorderBrush="#25FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="Bold"
                                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                                    Text="{Binding DisplayTitle}" />
                                                                <Border
                                                                    Margin="6,0,0,0"
                                                                    Padding="4,1"
                                                                    Background="#223B82F6"
                                                                    CornerRadius="3">
                                                                    <TextBlock
                                                                        FontSize="9.5"
                                                                        Foreground="#60A5FA"
                                                                        Text="{Binding TagText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                FontSize="10.5"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="{Binding Description}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="8,3"
                                                            Click="DeleteCustomSkillFromSettings_Click"
                                                            Content="🗑️ 删除"
                                                            FontSize="10"
                                                            Style="{StaticResource FluentButton}"
                                                            Tag="{Binding Id}"
                                                            Visibility="{Binding DeleteVisibility}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  子视图 2: 🎨 偏好与系统设置 (含数据存储)  -->
                    <ScrollViewer
                        x:Name="SettingViewPref"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,16">
                            <!--  模块 1: 系统偏好设置 (使用标准 Emoji 🎨 防止框形显示，加宽 ComboBox 防止文字截断)  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="🎨 偏好与系统设置" />

                                    <!--  悬浮窗透明度  -->
                                    <Grid Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="悬浮窗透明度" />
                                            <TextBlock
                                                FontSize="10.5"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="调节悬浮窗不透明度，兼顾聊天视线" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="SettingOpacityCombo"
                                            Grid.Column="1"
                                            Width="145"
                                            Height="28"
                                            Padding="8,0,24,0"
                                            VerticalContentAlignment="Center"
                                            FontSize="11"
                                            SelectionChanged="SettingOpacityCombo_SelectionChanged">
                                            <ComboBoxItem
                                                Content="100% 不透明"
                                                IsSelected="True"
                                                Tag="1.0" />
                                            <ComboBoxItem Content="95% 微透" Tag="0.95" />
