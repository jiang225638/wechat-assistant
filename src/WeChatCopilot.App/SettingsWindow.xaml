<Window x:Class="WeChatCopilot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 设置"
        Width="440" Height="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E2E">
    <StackPanel Margin="16">
        <TextBlock Text="接口基址（OpenAI 兼容，含 /v1）" Foreground="#FFDDDDDD" FontSize="12" />
        <TextBox x:Name="EndpointBox" Margin="0,4,0,0" FontSize="12" />

        <TextBlock Text="模型名" Foreground="#FFDDDDDD" FontSize="12" Margin="0,10,0,0" />
        <TextBox x:Name="ModelBox" Margin="0,4,0,0" FontSize="12" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="温度 (0-1)" Foreground="#FFDDDDDD" FontSize="12" />
                <TextBox x:Name="TempBox" Width="80" Margin="0,4,0,0" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="API Key（仅本机 DPAPI 加密保存，不回显明文到磁盘）" Foreground="#FFDDDDDD" FontSize="12" Margin="0,10,0,0" />
        <PasswordBox x:Name="KeyBox" Margin="0,4,0,0" FontSize="12" />

        <TextBlock Text="TraceMemo Local API 基址（冷链路画像，如 http://127.0.0.1:8080）" Foreground="#FFDDDDDD" FontSize="12" Margin="0,10,0,0" />
        <TextBox x:Name="TraceMemoBox" Margin="0,4,0,0" FontSize="12" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="保存" Width="90" IsDefault="True" Click="Save_Click" />
            <Button Content="取消" Width="90" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
